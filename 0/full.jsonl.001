{"parentUuid":"77b50386-69d4-47b8-b01d-de46181188ca","isSidechain":false,"promptId":"d4b1eb7e-fd38-4b94-9280-993e91f797a6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012TjYzB8hZKJ84fGbr3uRE4","type":"tool_result","content":"1\t\"\"\"The incident investigator: a Pydantic AI agent on local Gemma (Ollama, OpenAI-compatible).\n2\t\n3\tThe model reads the detection, checks metrics through tools, picks one fix template allowed\n4\tfor the cause and fills its params. It never writes router commands: an output validator\n5\trejects any template or param the fix templates don't allow, the error goes back to the\n6\tmodel once, and a second failure falls back to template `none`.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\timport asyncio\n12\timport logging\n13\timport time\n14\tfrom dataclasses import dataclass, field\n15\tfrom typing import Any\n16\t\n17\timport netcortex_fixes as fixes\n18\tfrom netcortex_core import (\n19\t    Cause,\n20\t    DetectionResult,\n21\t    IncidentReport,\n22\t    MetricsWindow,\n23\t    ModuleUnavailable,\n24\t    NewsCheck,\n25\t    Settings,\n26\t    Site,\n27\t    TemplateId,\n28\t    db,\n29\t    get_settings,\n30\t)\n31\tfrom pydantic import BaseModel, PrivateAttr\n32\tfrom pydantic_ai import Agent, ModelRetry, RunContext, capture_run_messages\n33\tfrom pydantic_ai.exceptions import UnexpectedModelBehavior\n34\tfrom pydantic_ai.messages import (\n35\t    ModelMessage,\n36\t    ModelResponse,\n37\t    RetryPromptPart,\n38\t    ToolCallPart,\n39\t    ToolReturnPart,\n40\t)\n41\tfrom pydantic_ai.models.openai import OpenAIChatModel, OpenAIChatModelSettings\n42\tfrom pydantic_ai.providers.ollama import OllamaProvider\n43\t\n44\tfrom netcortex_agent import facts, modules\n45\t\n46\tlog = logging.getLogger(__name__)\n47\t\n48\tMODEL_TIMEOUT_S = 180  # one model request; a full report on a 4B model can take a while\n49\tPARTNER_TIMEOUT_S = 15  # runbook search and news check\n50\t\n51\tINSTRUCTIONS = \"\"\"\\\n52\tYou investigate network incidents for a small internet provider that runs MikroTik routers.\n53\t\n54\tWork in this order:\n55\t1. Check the evidence with get_metrics (and get_forecast) on the key series.\n56\t2. Decide the likely cause. Causes: uplink_congestion, heavy_user, upstream_degradation,\n57\t   game_route_issue, wireless_interference, uplink_down, dns_slow, normal.\n58\t3. Call list_templates with that cause. Pick template_id only from its result.\n59\t4. For upstream_degradation or game_route_issue, call check_news.\n60\t5. Return the incident report.\n61\t\n62\tRules:\n63\t- template_params must match the chosen template's params exactly: names, types, limits.\n64\t  Use the site's real interfaces, gateways and IP addresses from the prompt and metrics.\n65\t- Never write router commands.\n66\t- If the evidence is unclear, use template none and a confidence below 0.4.\n67\t- summary: 1-2 plain sentences for the network owner.\n68\t- evidence: short facts with numbers, e.g. \"ether1 at 97% for 6 min\".\n69\t- customer_message_en: under 25 words, plain English, no jargon.\n70\t- customer_message_ur: the same message in Urdu script.\n71\t\"\"\"\n72\t\n73\tFALLBACK_EN = \"We are looking into a network problem and will update you soon.\"\n74\tFALLBACK_UR = \"ہم نیٹ ورک کے ایک مسئلے کو دیکھ رہے ہیں اور جلد آپ کو آگاہ کریں گے۔\"\n75\t\n76\t\n77\tclass Deps(BaseModel):\n78\t    \"\"\"What the tools see. Plain data, so Temporal can pass it to activities.\"\"\"\n79\t\n80\t    site_id: str\n81\t    detection: DetectionResult\n82\t    window: facts.WindowData\n83\t    site: Site | None = None\n84\t    tabpfn: DetectionResult | None = None  # second opinion, when the partner's detector ran\n85\t    _metrics: MetricsWindow | None = PrivateAttr(default=None)\n86\t\n87\t    def metrics(self) -> MetricsWindow:\n88\t        if self._metrics is None:\n89\t            self._metrics = self.window.to_window()\n90\t        return self._metrics\n91\t\n92\t    @classmethod\n93\t    def build(\n94\t        cls, site_id: str, detection: DetectionResult, window: MetricsWindow, site: Site | None\n95\t    ) -> Deps:\n96\t        return cls(\n97\t            site_id=site_id,\n98\t            detection=detection,\n99\t            window=facts.WindowData.from_window(window),\n100\t            site=site,\n101\t        )\n102\t\n103\t\n104\t@dataclass\n105\tclass RunStats:\n106\t    \"\"\"How a run went, for logs, traces and the thinking comparison.\"\"\"\n107\t\n108\t    seconds: float = 0.0\n109\t    tool_calls: list[str] = field(default_factory=list)\n110\t    output_retries: int = 0\n111\t    retry_reasons: list[str] = field(default_factory=list)  # what the model was told to fix\n112\t    fell_back: bool = False\n113\t\n114\t\n115\tincident_agent = Agent(\n116\t    name=\"netcortex_investigator\",\n117\t    deps_type=Deps,\n118\t    output_type=IncidentReport,\n119\t    instructions=INSTRUCTIONS,\n120\t    retries={\"tools\": 2, \"output\": 1},\n121\t)\n122\t\n123\t\n124\t@incident_agent.tool\n125\tdef get_metrics(ctx: RunContext[Deps], series: str, minutes: int = 15) -> dict[str, Any]:\n126\t    \"\"\"Recent values of one series, e.g. 'probe:8.8.8.8:rtt_ms', 'iface:ether1:util_pct'\n127\t    or 'subscriber:10.0.0.42:rx_bps'. Returns latest, mean, min, max and up to 10 points.\"\"\"\n128\t    return facts.metric_summary(ctx.deps.metrics(), series, minutes)\n129\t\n130\t\n131\t@incident_agent.tool\n132\tdef get_forecast(ctx: RunContext[Deps], series: str) -> dict[str, Any]:\n133\t    \"\"\"The detector's p10/p50/p90 forecast for one series, 1-5 minutes ahead.\"\"\"\n134\t    tabpfn = ctx.deps.tabpfn\n135\t    if tabpfn and any(f.series_key == series for f in tabpfn.series):\n136\t        return facts.forecast_summary(tabpfn, series) | {\"model\": tabpfn.model}\n137\t    return facts.forecast_summary(ctx.deps.detection, series)\n138\t\n139\t\n140\t@incident_agent.tool_plain\n141\tdef list_templates(cause: Cause) -> list[dict[str, Any]]:\n142\t    \"\"\"Fix templates allowed for a cause, with their params. `none` is always allowed.\"\"\"\n143\t    return [\n144\t        {\n145\t            \"id\": template.id.value,\n146\t            \"description\": template.description,\n147\t            \"params\": {name: spec.describe() for name, spec in template.agent_params().items()},\n148\t        }\n149\t        for template in fixes.templates_for(cause)\n150\t    ]\n151\t\n152\t\n153\t@incident_agent.tool_plain\n154\tasync def search_runbook(query: str) -> list[dict[str, Any]] | str:\n155\t    \"\"\"Search MikroTik RouterOS documentation. Returns the top 3 passages.\"\"\"\n156\t    try:\n157\t        chunks = await asyncio.wait_for(\n158\t            asyncio.to_thread(modules.search_runbook, query, 3), PARTNER_TIMEOUT_S\n159\t        )\n160\t    except (ModuleUnavailable, TimeoutError) as exc:\n161\t        return f\"runbook search unavailable ({type(exc).__name__})\"\n162\t    return [\n163\t        chunk.model_dump(include={\"title\", \"section\", \"text\", \"source_url\"}) for chunk in chunks\n164\t    ]\n165\t\n166\t\n167\t@incident_agent.tool_plain\n168\tasync def check_news(provider: str | None = None, target: str | None = None) -> dict[str, Any]:\n169\t    \"\"\"Search recent news for an outage at the upstream provider or a game server.\"\"\"\n170\t    try:\n171\t        news = await asyncio.wait_for(\n172\t            asyncio.to_thread(modules.check_news, provider, target), PARTNER_TIMEOUT_S\n173\t        )\n174\t    except (ModuleUnavailable, TimeoutError) as exc:\n175\t        news = NewsCheck(available=False, summary=f\"Outage check failed ({type(exc).__name__}).\")\n176\t    return news.model_dump(mode=\"json\")\n177\t\n178\t\n179\t@incident_agent.output_validator\n180\tdef check_fix(ctx: RunContext[Deps], report: IncidentReport) -> IncidentReport:\n181\t    \"\"\"Only templates allowed for the cause, with params that pass the template schema.\"\"\"\n182\t    allowed = [t.id for t in fixes.templates_for(report.likely_cause)]\n183\t    if report.template_id not in allowed:\n184\t        raise ModelRetry(\n185\t            f\"template_id {report.template_id.value!r} is not allowed for cause \"\n186\t            f\"{report.likely_cause.value!r}. Allowed: {[t.value for t in allowed]}.\"\n187\t        )\n188\t    agent_params = fixes.get_template(report.template_id).agent_params()\n189\t    params = {k: v for k, v in report.template_params.items() if k in agent_params}\n190\t    observed = None\n191\t    if report.template_id is TemplateId.QUEUE_LIMIT and \"target\" in params:\n192\t        try:\n193\t            observed = facts.subscriber_rates(ctx.deps.metrics(), str(params[\"target\"]))\n194\t        except ValueError:\n195\t            observed = None  # not an IP; the schema check below reports it\n196\t    try:\n197\t        clean = fixes.validate(report.template_id, params, observed)\n198\t    except fixes.ParamError as exc:\n199\t        schema = {name: spec.describe() for name, spec in agent_params.items()}\n200\t        raise ModelRetry(\n201\t            f\"template_params are invalid: {exc}. {report.template_id.value} needs exactly \"\n202\t            f\"these params: {schema}. Keep template_id {report.template_id.value!r} and the \"\n203\t            \"rest of the report; correct only template_params.\"\n204\t        ) from exc\n205\t    return report.model_copy(\n206\t        update={\"template_params\": {k: v for k, v in clean.items() if k in agent_params}}\n207\t    )\n208\t\n209\t\n210\tdef build_model(settings: Settings) -> OpenAIChatModel:\n211\t    base_url = settings.ollama_base_url.rstrip(\"/\") + \"/v1\"\n212\t    return OpenAIChatModel(settings.agent_model, provider=OllamaProvider(base_url=base_url))\n213\t\n214\t\n215\tdef model_settings(thinking: bool) -> OpenAIChatModelSettings:\n216\t    settings = OpenAIChatModelSettings(temperature=0.2, timeout=MODEL_TIMEOUT_S)\n217\t    if not thinking:\n218\t        # Gemma thinks by default; Ollama's OpenAI API turns it off with reasoning_effort=none.\n219\t        settings[\"openai_reasoning_effort\"] = \"none\"  # type: ignore[typeddict-item]\n220\t    return settings\n221\t\n222\t\n223\tdef fallback_report(detection: DetectionResult) -> IncidentReport:\n224\t    \"\"\"Notify-only report when the model can't produce a valid one.\"\"\"\n225\t    return IncidentReport(\n226\t        summary=(\n227\t            \"Automatic investigation could not choose a safe fix. The detector suggests \"\n228\t            f\"{detection.cause_guess.value} ({detection.cause_confidence:.0%}); please check.\"\n229\t        ),\n230\t        likely_cause=detection.cause_guess,\n231\t        confidence=min(detection.cause_confidence, 0.3),\n232\t        evidence=detection.evidence[:5],\n233\t        template_id=TemplateId.NONE,\n234\t        customer_message_en=FALLBACK_EN,\n235\t        customer_message_ur=FALLBACK_UR,\n236\t    )\n237\t\n238\t\n239\tdef load_site(site_id: str) -> Site | None:\n240\t    \"\"\"The site's layout from the database, or None if it isn't available.\"\"\"\n241\t    try:\n242\t        with db.get_pool().connection() as conn:\n243\t            return db.fetch_site(conn, site_id)\n244\t    except Exception as exc:\n245\t        log.warning(\"site %s layout unavailable: %s\", site_id, type(exc).__name__)\n246\t        return None\n247\t\n248\t\n249\tdef with_news(report: IncidentReport, messages: list[ModelMessage]) -> IncidentReport:\n250\t    \"\"\"Copy the last check_news result into the report if the model left it out.\"\"\"\n251\t    if report.upstream_check is not None:\n252\t        return report\n253\t    for message in reversed(messages):\n254\t        for part in message.parts:\n255\t            if isinstance(part, ToolReturnPart) and part.tool_name == \"check_news\":\n256\t                news = NewsCheck.model_validate(part.content)\n257\t                return report.model_copy(update={\"upstream_check\": news})\n258\t    return report\n259\t\n260\t\n261\tdef _stats(messages: list[ModelMessage], started: float) -> RunStats:\n262\t    stats = RunStats(seconds=round(time.perf_counter() - started, 1))\n263\t    for message in messages:\n264\t        for part in message.parts:\n265\t            if isinstance(message, ModelResponse) and isinstance(part, ToolCallPart):\n266\t                if part.tool_name != \"final_result\":\n267\t                    stats.tool_calls.append(part.tool_name)\n268\t            elif isinstance(part, RetryPromptPart) and part.tool_name in (None, \"final_result\"):\n269\t                stats.output_retries += 1\n270\t                stats.retry_reasons.append(str(part.content)[:300])\n271\t    return stats\n272\t\n273\t\n274\tasync def run_investigation(\n275\t    site_id: str,\n276\t    detection: DetectionResult,\n277\t    window: MetricsWindow,\n278\t    *,\n279\t    site: Site | None = None,\n280\t    thinking: bool = False,\n281\t    settings: Settings | None = None,\n282\t) -> tuple[IncidentReport, RunStats]:\n283\t    \"\"\"investigate() plus run statistics; lets callers pass the site and thinking mode.\"\"\"\n284\t    settings = settings or get_settings()\n285\t    deps = Deps.build(site_id, detection, window, site)\n286\t    prompt = facts.build_prompt(site_id, site, detection, window)\n287\t    started = time.perf_counter()\n288\t    with capture_run_messages() as messages:\n289\t        try:\n290\t            result = await incident_agent.run(\n291\t                prompt,\n292\t                deps=deps,\n293\t                model=build_model(settings),\n294\t                model_settings=model_settings(thinking),\n295\t            )\n296\t        except UnexpectedModelBehavior as exc:\n297\t            log.warning(\"agent output failed validation twice, using template none: %s\", exc)\n298\t            stats = _stats(messages, started)\n299\t            stats.fell_back = True\n300\t            return fallback_report(detection), stats\n301\t    report = with_news(result.output, result.all_messages())\n302\t    return report, _stats(result.all_messages(), started)\n303\t\n304\t\n305\tasync def investigate(\n306\t    site_id: str, detection: DetectionResult, window: MetricsWindow\n307\t) -> IncidentReport:\n308\t    \"\"\"Investigate one detection. Connection errors propagate so Temporal can retry.\"\"\"\n309\t    site = await asyncio.to_thread(load_site, site_id)\n310\t    report, stats = await run_investigation(site_id, detection, window, site=site)\n311\t    log.info(\n312\t        \"investigated %s in %.1fs: %s -> %s (tools %s, retries %d, fallback %s)\",\n313\t        site_id, stats.seconds, report.likely_cause.value, report.template_id.value,\n314\t        stats.tool_calls, stats.output_retries, stats.fell_back,\n315\t    )  # fmt: skip\n316\t    return report\n317\t"}]},"uuid":"0e735228-96a3-4cb8-85ae-456779993e0e","timestamp":"2026-10-18T21:42:22.906Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\hp\\NetCortex\\packages\\agent\\src\\netcortex_agent\\agent.py","content":"\"\"\"The incident investigator: a Pydantic AI agent on local Gemma (Ollama, OpenAI-compatible).\n\nThe model reads the detection, checks metrics through tools, picks one fix template allowed\nfor the cause and fills its params. It never writes router commands: an output validator\nrejects any template or param the fix templates don't allow, the error goes back to the\nmodel once, and a second failure falls back to template `none`.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport logging\nimport time\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nimport netcortex_fixes as fixes\nfrom netcortex_core import (\n    Cause,\n    DetectionResult,\n    IncidentReport,\n    MetricsWindow,\n    ModuleUnavailable,\n    NewsCheck,\n    Settings,\n    Site,\n    TemplateId,\n    db,\n    get_settings,\n)\nfrom pydantic import BaseModel, PrivateAttr\nfrom pydantic_ai import Agent, ModelRetry, RunContext, capture_run_messages\nfrom pydantic_ai.exceptions import UnexpectedModelBehavior\nfrom pydantic_ai.messages import (\n    ModelMessage,\n    ModelResponse,\n    RetryPromptPart,\n    ToolCallPart,\n    ToolReturnPart,\n)\nfrom pydantic_ai.models.openai import OpenAIChatModel, OpenAIChatModelSettings\nfrom pydantic_ai.providers.ollama import OllamaProvider\n\nfrom netcortex_agent import facts, modules\n\nlog = logging.getLogger(__name__)\n\nMODEL_TIMEOUT_S = 180  # one model request; a full report on a 4B model can take a while\nPARTNER_TIMEOUT_S = 15  # runbook search and news check\n\nINSTRUCTIONS = \"\"\"\\\nYou investigate network incidents for a small internet provider that runs MikroTik routers.\n\nWork in this order:\n1. Check the evidence with get_metrics (and get_forecast) on the key series.\n2. Decide the likely cause. Causes: uplink_congestion, heavy_user, upstream_degradation,\n   game_route_issue, wireless_interference, uplink_down, dns_slow, normal.\n3. Call list_templates with that cause. Pick template_id only from its result.\n4. For upstream_degradation or game_route_issue, call check_news.\n5. Return the incident report.\n\nRules:\n- template_params must match the chosen template's params exactly: names, types, limits.\n  Use the site's real interfaces, gateways and IP addresses from the prompt and metrics.\n- Never write router commands.\n- If the evidence is unclear, use template none and a confidence below 0.4.\n- summary: 1-2 plain sentences for the network owner.\n- evidence: short facts with numbers, e.g. \"ether1 at 97% for 6 min\".\n- customer_message_en: under 25 words, plain English, no jargon.\n- customer_message_ur: the same message in Urdu script.\n\"\"\"\n\nFALLBACK_EN = \"We are looking into a network problem and will update you soon.\"\nFALLBACK_UR = \"ہم نیٹ ورک کے ایک مسئلے کو دیکھ رہے ہیں اور جلد آپ کو آگاہ کریں گے۔\"\n\n\nclass Deps(BaseModel):\n    \"\"\"What the tools see. Plain data, so Temporal can pass it to activities.\"\"\"\n\n    site_id: str\n    detection: DetectionResult\n    window: facts.WindowData\n    site: Site | None = None\n    tabpfn: DetectionResult | None = None  # second opinion, when the partner's detector ran\n    _metrics: MetricsWindow | None = PrivateAttr(default=None)\n\n    def metrics(self) -> MetricsWindow:\n        if self._metrics is None:\n            self._metrics = self.window.to_window()\n        return self._metrics\n\n    @classmethod\n    def build(\n        cls, site_id: str, detection: DetectionResult, window: MetricsWindow, site: Site | None\n    ) -> Deps:\n        return cls(\n            site_id=site_id,\n            detection=detection,\n            window=facts.WindowData.from_window(window),\n            site=site,\n        )\n\n\n@dataclass\nclass RunStats:\n    \"\"\"How a run went, for logs, traces and the thinking comparison.\"\"\"\n\n    seconds: float = 0.0\n    tool_calls: list[str] = field(default_factory=list)\n    output_retries: int = 0\n    retry_reasons: list[str] = field(default_factory=list)  # what the model was told to fix\n    fell_back: bool = False\n\n\nincident_agent = Agent(\n    name=\"netcortex_investigator\",\n    deps_type=Deps,\n    output_type=IncidentReport,\n    instructions=INSTRUCTIONS,\n    retries={\"tools\": 2, \"output\": 1},\n)\n\n\n@incident_agent.tool\ndef get_metrics(ctx: RunContext[Deps], series: str, minutes: int = 15) -> dict[str, Any]:\n    \"\"\"Recent values of one series, e.g. 'probe:8.8.8.8:rtt_ms', 'iface:ether1:util_pct'\n    or 'subscriber:10.0.0.42:rx_bps'. Returns latest, mean, min, max and up to 10 points.\"\"\"\n    return facts.metric_summary(ctx.deps.metrics(), series, minutes)\n\n\n@incident_agent.tool\ndef get_forecast(ctx: RunContext[Deps], series: str) -> dict[str, Any]:\n    \"\"\"The detector's p10/p50/p90 forecast for one series, 1-5 minutes ahead.\"\"\"\n    tabpfn = ctx.deps.tabpfn\n    if tabpfn and any(f.series_key == series for f in tabpfn.series):\n        return facts.forecast_summary(tabpfn, series) | {\"model\": tabpfn.model}\n    return facts.forecast_summary(ctx.deps.detection, series)\n\n\n@incident_agent.tool_plain\ndef list_templates(cause: Cause) -> list[dict[str, Any]]:\n    \"\"\"Fix templates allowed for a cause, with their params. `none` is always allowed.\"\"\"\n    return [\n        {\n            \"id\": template.id.value,\n            \"description\": template.description,\n            \"params\": {name: spec.describe() for name, spec in template.agent_params().items()},\n        }\n        for template in fixes.templates_for(cause)\n    ]\n\n\n@incident_agent.tool_plain\nasync def search_runbook(query: str) -> list[dict[str, Any]] | str:\n    \"\"\"Search MikroTik RouterOS documentation. Returns the top 3 passages.\"\"\"\n    try:\n        chunks = await asyncio.wait_for(\n            asyncio.to_thread(modules.search_runbook, query, 3), PARTNER_TIMEOUT_S\n        )\n    except (ModuleUnavailable, TimeoutError) as exc:\n        return f\"runbook search unavailable ({type(exc).__name__})\"\n    return [\n        chunk.model_dump(include={\"title\", \"section\", \"text\", \"source_url\"}) for chunk in chunks\n    ]\n\n\n@incident_agent.tool_plain\nasync def check_news(provider: str | None = None, target: str | None = None) -> dict[str, Any]:\n    \"\"\"Search recent news for an outage at the upstream provider or a game server.\"\"\"\n    try:\n        news = await asyncio.wait_for(\n            asyncio.to_thread(modules.check_news, provider, target), PARTNER_TIMEOUT_S\n        )\n    except (ModuleUnavailable, TimeoutError) as exc:\n        news = NewsCheck(available=False, summary=f\"Outage check failed ({type(exc).__name__}).\")\n    return news.model_dump(mode=\"json\")\n\n\n@incident_agent.output_validator\ndef check_fix(ctx: RunContext[Deps], report: IncidentReport) -> IncidentReport:\n    \"\"\"Only templates allowed for the cause, with params that pass the template schema.\"\"\"\n    allowed = [t.id for t in fixes.templates_for(report.likely_cause)]\n    if report.template_id not in allowed:\n        raise ModelRetry(\n            f\"template_id {report.template_id.value!r} is not allowed for cause \"\n            f\"{report.likely_cause.value!r}. Allowed: {[t.value for t in allowed]}.\"\n        )\n    agent_params = fixes.get_template(report.template_id).agent_params()\n    params = {k: v for k, v in report.template_params.items() if k in agent_params}\n    observed = None\n    if report.template_id is TemplateId.QUEUE_LIMIT and \"target\" in params:\n        try:\n            observed = facts.subscriber_rates(ctx.deps.metrics(), str(params[\"target\"]))\n        except ValueError:\n            observed = None  # not an IP; the schema check below reports it\n    try:\n        clean = fixes.validate(report.template_id, params, observed)\n    except fixes.ParamError as exc:\n        schema = {name: spec.describe() for name, spec in agent_params.items()}\n        raise ModelRetry(\n            f\"template_params are invalid: {exc}. {report.template_id.value} needs exactly \"\n            f\"these params: {schema}. Keep template_id {report.template_id.value!r} and the \"\n            \"rest of the report; correct only template_params.\"\n        ) from exc\n    return report.model_copy(\n        update={\"template_params\": {k: v for k, v in clean.items() if k in agent_params}}\n    )\n\n\ndef build_model(settings: Settings) -> OpenAIChatModel:\n    base_url = settings.ollama_base_url.rstrip(\"/\") + \"/v1\"\n    return OpenAIChatModel(settings.agent_model, provider=OllamaProvider(base_url=base_url))\n\n\ndef model_settings(thinking: bool) -> OpenAIChatModelSettings:\n    settings = OpenAIChatModelSettings(temperature=0.2, timeout=MODEL_TIMEOUT_S)\n    if not thinking:\n        # Gemma thinks by default; Ollama's OpenAI API turns it off with reasoning_effort=none.\n        settings[\"openai_reasoning_effort\"] = \"none\"  # type: ignore[typeddict-item]\n    return settings\n\n\ndef fallback_report(detection: DetectionResult) -> IncidentReport:\n    \"\"\"Notify-only report when the model can't produce a valid one.\"\"\"\n    return IncidentReport(\n        summary=(\n            \"Automatic investigation could not choose a safe fix. The detector suggests \"\n            f\"{detection.cause_guess.value} ({detection.cause_confidence:.0%}); please check.\"\n        ),\n        likely_cause=detection.cause_guess,\n        confidence=min(detection.cause_confidence, 0.3),\n        evidence=detection.evidence[:5],\n        template_id=TemplateId.NONE,\n        customer_message_en=FALLBACK_EN,\n        customer_message_ur=FALLBACK_UR,\n    )\n\n\ndef load_site(site_id: str) -> Site | None:\n    \"\"\"The site's layout from the database, or None if it isn't available.\"\"\"\n    try:\n        with db.get_pool().connection() as conn:\n            return db.fetch_site(conn, site_id)\n    except Exception as exc:\n        log.warning(\"site %s layout unavailable: %s\", site_id, type(exc).__name__)\n        return None\n\n\ndef with_news(report: IncidentReport, messages: list[ModelMessage]) -> IncidentReport:\n    \"\"\"Copy the last check_news result into the report if the model left it out.\"\"\"\n    if report.upstream_check is not None:\n        return report\n    for message in reversed(messages):\n        for part in message.parts:\n            if isinstance(part, ToolReturnPart) and part.tool_name == \"check_news\":\n                news = NewsCheck.model_validate(part.content)\n                return report.model_copy(update={\"upstream_check\": news})\n    return report\n\n\ndef _stats(messages: list[ModelMessage], started: float) -> RunStats:\n    stats = RunStats(seconds=round(time.perf_counter() - started, 1))\n    for message in messages:\n        for part in message.parts:\n            if isinstance(message, ModelResponse) and isinstance(part, ToolCallPart):\n                if part.tool_name != \"final_result\":\n                    stats.tool_calls.append(part.tool_name)\n            elif isinstance(part, RetryPromptPart) and part.tool_name in (None, \"final_result\"):\n                stats.output_retries += 1\n                stats.retry_reasons.append(str(part.content)[:300])\n    return stats\n\n\nasync def run_investigation(\n    site_id: str,\n    detection: DetectionResult,\n    window: MetricsWindow,\n    *,\n    site: Site | None = None,\n    thinking: bool = False,\n    settings: Settings | None = None,\n) -> tuple[IncidentReport, RunStats]:\n    \"\"\"investigate() plus run statistics; lets callers pass the site and thinking mode.\"\"\"\n    settings = settings or get_settings()\n    deps = Deps.build(site_id, detection, window, site)\n    prompt = facts.build_prompt(site_id, site, detection, window)\n    started = time.perf_counter()\n    with capture_run_messages() as messages:\n        try:\n            result = await incident_agent.run(\n                prompt,\n                deps=deps,\n                model=build_model(settings),\n                model_settings=model_settings(thinking),\n            )\n        except UnexpectedModelBehavior as exc:\n            log.warning(\"agent output failed validation twice, using template none: %s\", exc)\n            stats = _stats(messages, started)\n            stats.fell_back = True\n            return fallback_report(detection), stats\n    report = with_news(result.output, result.all_messages())\n    return report, _stats(result.all_messages(), started)\n\n\nasync def investigate(\n    site_id: str, detection: DetectionResult, window: MetricsWindow\n) -> IncidentReport:\n    \"\"\"Investigate one detection. Connection errors propagate so Temporal can retry.\"\"\"\n    site = await asyncio.to_thread(load_site, site_id)\n    report, stats = await run_investigation(site_id, detection, window, site=site)\n    log.info(\n        \"investigated %s in %.1fs: %s -> %s (tools %s, retries %d, fallback %s)\",\n        site_id, stats.seconds, report.likely_cause.value, report.template_id.value,\n        stats.tool_calls, stats.output_retries, stats.fell_back,\n    )  # fmt: skip\n    return report\n","numLines":317,"startLine":1,"totalLines":317}},"sourceToolAssistantUUID":"77b50386-69d4-47b8-b01d-de46181188ca","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"userType":"external","entrypoint":"claude-vscode","cwd":"C:\\Users\\hp\\NetCortex","sessionId":"88958964-2992-40b7-a2b1-a4d7674680fc","version":"2.1.301","gitBranch":"a/cleanup","slug":"wiggly-plotting-biscuit"}
