t.cause)} - ${incident.site_id}`),\nservices/api/src/netcortex_api/ui/app.js:137:        h(\"span\", { class: \"muted\" }, `${incident.site_id}, opened ${when(incident.opened_at)}`),\nservices/api/src/netcortex_api/ui/app.js:259:    site_id: incident.site_id, series: key, from: from.toISOString(), to: to.toISOString(),\nservices/api/src/netcortex_api/ui/app.js:295:      site_id: form.get(\"site_id\"),\nservices/api/src/netcortex_api/ui/app.js:299:    note.textContent = `Injected ${words(label.scenario_type)} on ${label.site_id} until ` +\nservices/api/src/netcortex_api/ui/index.html:22:            <select name=\"site_id\" id=\"sim-site\"><option>sim-tower</option></select>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"C:\\Users\\hp\\NetCortex\\services\\api\\src\\netcortex_api\\ui\\app.js","hunks":[{"oldStart":193,"oldLines":9,"newStart":193,"newLines":6,"lines":["       h(\"dt\", {}, \"Proposed fix\"),","       h(\"dd\", { class: \"mono\" },","         report.template_id === \"none\" ? \"none (notify only)\" : `${report.template_id}  ${params}`),","-      report.upstream_check?.available && [","-        h(\"dt\", {}, \"Upstream\"), h(\"dd\", {}, report.upstream_check.summary),","-      ],","     ),","     report.evidence.length > 0 && [","       h(\"h3\", {}, \"Evidence\"),"]}]}],"moreFiles":0,"changedFiles":["C:\\Users\\hp\\NetCortex\\services\\api\\src\\netcortex_api\\ui\\app.js"]}},"serverClassifierContext":{"request":"a199035f-7095-4bba-82aa-4d8777d3a02f","context":{"git_state":{"cwd":"/c/Users/hp/NetCortex","root":"/c/Users/hp/NetCortex","branch":"a/cleanup","default_branch":null,"status":{"clean":false,"counts":{"staged":2,"modified":12,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"aunraza19/NetCortex","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"aunraza1