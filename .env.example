# Copy to .env and fill in. Never commit .env; the repo and its Entire transcripts are public.
# Field names in netcortex_core.Settings are these names in lowercase.

# Database: Tiger Cloud (TimescaleDB)
DATABASE_URL=

# Model: Gemma in Ollama on the Mac mini (OpenAI-compatible API at /v1)
OLLAMA_BASE_URL=http://<mac-lan-address>:11434
AGENT_MODEL=gemma4:e4b

# Tracing (optional; empty switches it off)
SENTRY_DSN_BACKEND=

# Only for the experimental partner packages (TabPFN detector, runbook search, news check).
# The running system doesn't use them.
EMBED_MODEL=embeddinggemma
TABPFN_MODE=cloud            # cloud | local
TABPFN_TOKEN=                # TABPFN_API_KEY is accepted too
SERPAPI_API_KEY=

# Runtime
TEMPORAL_ADDRESS=localhost:7233
DEMO_MODE=false
VERIFY_WAIT_S=60            # watch time after applying a fix; production uses 300
HTTP_TIMEOUT_S=10

# Routers. Fixes are applied to CHR unless APPLY_TARGET=real is set explicitly.
APPLY_TARGET=chr             # chr | real
CHR_REST_URL=
CHR_USERNAME=
CHR_PASSWORD=

# Live collector (uv run collector)
SITE_ID_LIVE=home-lab
COLLECTOR_GAME_SERVER=       # one regional game server IP or hostname to ping
COLLECTOR_GATEWAY=           # empty: hop 1 of a traceroute at startup
COLLECTOR_UPSTREAM_HOP=      # empty: hop 2 of that traceroute
COLLECTOR_INTERVAL_S=10
COLLECTOR_PINGS=5
COLLECTOR_DNS_QUERY=google.com
COLLECTOR_DNS_TIMEOUT_S=2
COLLECTOR_ROUTER_STATS=false # true once CHR_REST_URL/USERNAME/PASSWORD are set
