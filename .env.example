# Copy to .env and fill in. Never commit .env; the repo and its Entire transcripts are public.
# Field names in netcortex_core.Settings are these names in lowercase.

# Shared database: Tiger Cloud (TimescaleDB + pgvector)
DATABASE_URL=

# Models: Ollama on the Mac mini over Tailscale (OpenAI-compatible API at /v1)
OLLAMA_BASE_URL=http://<mac-tailscale-name>:11434
AGENT_MODEL=gemma4:e4b
EMBED_MODEL=embeddinggemma

# Detector
TABPFN_MODE=cloud            # cloud | local
TABPFN_TOKEN=                # TABPFN_API_KEY is accepted too

# Optional cloud add-ons; leave empty to switch them off
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SERPAPI_API_KEY=
SENTRY_DSN_BACKEND=

# Runtime
TEMPORAL_ADDRESS=<laptop-tailscale-name>:7233
DEMO_MODE=false
HTTP_TIMEOUT_S=10

# Routers. Fixes are applied to CHR unless APPLY_TARGET=real is set explicitly.
APPLY_TARGET=chr             # chr | real
CHR_REST_URL=
CHR_USERNAME=admin
CHR_PASSWORD=

# Live collector
SITE_ID_LIVE=home-lab

# Web UI (apps/web only)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_API_BASE_URL=http://<laptop-tailscale-name>:8000
NEXT_PUBLIC_API_MODE=mock    # mock | live
